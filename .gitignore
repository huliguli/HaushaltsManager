# ==========================================================================
#  HaushaltsManager — .gitignore
#  PRIVACY-CRITICAL: real personal finance data must NEVER reach the repo.
# ==========================================================================

# --- Real / local financial data (NEVER commit) -------------------------
database/seed.local.json
database/*.local.json
*.local.json
database/*.db
*.db
*.sqlite
*.sqlite3

# The anonymized sample seed IS committed on purpose:
!database/seed.sample.json

# --- Runtime app data / logs --------------------------------------------
logs/
*.log
config.json
src/config.json

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# --- Virtual environments -----------------------------------------------
.venv/
venv/
env/
ENV/

# --- PyInstaller / build output -----------------------------------------
build/
dist/
*.spec.bak
*.manifest

# --- Icon preview / intermediate renders (sources app.ico/app.svg are kept) --
assets/concept_*.png
assets/concepts_preview.png
assets/app_icon.png

# --- Local notes (never publish) ----------------------------------------
*.local.md

# --- Editors / OS -------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store
